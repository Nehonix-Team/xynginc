{
  "script": "simulations/XCIS/src/server.ts",
  "watch": [
    "."
  ],
  "ignore": [
    "node_modules",
    "dist",
    ".git",
    ".next",
    "build",
    "coverage"
  ],
  "extensions": [
    ".ts",
    ".tsx",
