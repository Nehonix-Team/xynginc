{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "node",
    "declaration": true,
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "*": [
        "./src/*"
      ],
      "xynginc": [
        "../../src/index.ts"
      ],
      "xynginc/*": [
        "../../src/*"
      ]
    }
  },
  "include": [
    "src/**/*"
  ]
}